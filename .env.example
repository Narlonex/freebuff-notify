# Copy this file to .env and fill in your values.
# .env is ignored by git — secrets never leave your machine.

# ---------- Telegram (primary channel) — @BotFather ----------
# Easiest: run setup.cmd — it asks for the token and finds chat_id itself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- WhatsApp (Green API) — optional backup — https://green-api.com ----------
# idInstance and apiToken are in the Green API console after linking your phone.
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
# Your number with country code and the @c.us suffix, e.g. 421900000000@c.us
GREENAPI_CHAT_ID=

# ---------- optional ----------
# 1 = disable all notifications
# NOTIFY_DISABLED=0
# Default channel without --channel: tg (Telegram, WhatsApp fallback) or wsp
# NOTIFY_PRIMARY=tg
# always (default) or failures — when to notify about tests
# NOTIFY_TESTS=always
# Project name shown in the message (default: current folder name)
# NOTIFY_PROJECT=
# API endpoint overrides — debugging only
# GREENAPI_BASE_URL=https://api.green-api.com
# TELEGRAM_BASE_URL=https://api.telegram.org
